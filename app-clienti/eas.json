{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://revobeautyerp-production.up.railway.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://erp.revobeauty.it"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804702856"
      },
      "android": {
        "track": "production",
        "changesNotSentForReview": true
      }
    }
  }
}
