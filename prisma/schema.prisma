generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CLIENTS
// ============================================================
model Client {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String
  birthDate        String?
  gender           String?
  address          String?
  city             String?
  notes            String?
  privateNotes     String?
  allergies        String?
  preferences      String[] @default([])
  tags             String[] @default([])
  vipLevel         Int      @default(0)
  loyaltyPoints    Int      @default(0)
  cashback         Float    @default(0)
  gdprConsent      Boolean  @default(true)
  marketingConsent Boolean  @default(false)
  avatar           String?
  createdAt        String
  lastVisit        String?
  totalSpent       Float    @default(0)
  visitCount       Int      @default(0)
  avgTicket        Float    @default(0)
  referredBy       String?
  customTreatments Json     @default("[]")
  priceListId      String?
  medicalRecord    Json?    // anamnesi / scheda tecnica estetica

  appointments     Appointment[]
  clientPackages   ClientPackage[]
  giftCardsPurchased GiftCard[] @relation("GiftCardBuyer")
  mobileAccount    MobileAccount?
  photos           ClientPhoto[]
  consents         ClientConsent[]

  @@map("clients")
}

// Foto (prima/dopo) e documenti del cliente — immagine in base64 compressa lato client.
model ClientPhoto {
  id        String  @id @default(cuid())
  clientId  String
  kind      String  @default("before") // before | after | document
  data      String  // data URL base64
  label     String?
  treatment String?
  createdAt String

  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_photos")
}

// Consensi firmati del cliente (privacy, trattamento, ...) con firma opzionale.
model ClientConsent {
  id            String  @id @default(cuid())
  clientId      String
  title         String
  signatureData String? // firma disegnata in base64 (opzionale)
  signedAt      String
  notes         String?

  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_consents")
}

// ============================================================
// MOBILE ACCOUNTS (account di accesso dell'app clienti)
// ============================================================
model MobileAccount {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  sessionToken String? @unique
  createdAt    String

  clientId     String  @unique
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("mobile_accounts")
}

// ============================================================
// OPERATORS
// ============================================================
model Operator {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  avatar          String?
  color           String
  specializations String[] @default([])
  locationIds     String[] @default([])
  schedule        Json     @default("{}")
  contractHours   Float    @default(0)
  isActive        Boolean  @default(true)
  phone           String?
  email           String?
  commission      Float    @default(0)
  hireDate        String
  isResource      Boolean  @default(false) // true = cabina/macchinario prenotabile senza operatrice
  monthlyCost     Float    @default(0)     // costo mensile lordo azienda (per calcolare il costo orario)

  appointments    Appointment[]

  @@map("operators")
}

// ============================================================
// AMMINISTRAZIONE (costi fissi/variabili, investimenti, cash flow, obiettivi, financials)
// Record condivisi salvati come JSON, distinti per "kind".
// ============================================================
model AdminEntry {
  rowId     String @id
  kind      String
  entityId  String
  data      Json
  createdAt String

  @@index([kind])
  @@map("admin_entries")
}

// ============================================================
// MAGAZZINO (prodotti)
// ============================================================
model Product {
  id         String  @id @default(cuid())
  name       String
  brand      String  @default("")
  category   String  @default("Viso")
  sku        String  @default("")
  barcode    String?
  price      Float   @default(0)
  costPrice  Float   @default(0)
  stock      Int     @default(0)
  minStock   Int     @default(5)
  locationId String  @default("loc1")
  isActive   Boolean @default(true)
  createdAt  String  @default("")

  @@map("products")
}

// ============================================================
// SPESE SOCI (anticipi dei soci, dare/avere)
// ============================================================
model PartnerExpense {
  id          String @id @default(cuid())
  partner     String
  amount      Float
  description String
  date        String
  createdAt   String

  @@map("partner_expenses")
}

// ============================================================
// TO-DO (cose da fare)
// ============================================================
model TodoItem {
  id         String  @id @default(cuid())
  title      String
  list       String  @default("todo") // todo | shopping (cose da comprare)
  done       Boolean @default(false)
  priority   String  @default("normal") // low | normal | high
  dueDate    String?
  assignee   String?
  createdAt  String
  completedAt String?

  @@map("todo_items")
}

// ============================================================
// AGENDA BLOCKS (fasce orarie bloccate: pause, chiusure)
// ============================================================
model AgendaBlock {
  id         String  @id @default(cuid())
  operatorId String
  date       String
  startTime  String
  endTime    String
  reason     String?
  createdAt  String

  @@map("agenda_blocks")
}

// ============================================================
// TREATMENTS
// ============================================================
model Treatment {
  id               String  @id @default(cuid())
  name             String
  category         String
  duration         Int
  price            Float
  priceMale        Float?
  priceFemale      Float?
  durationMale     Int?
  durationFemale   Int?
  description      String?
  requiresRoom     Boolean @default(false)
  requiresEquipment String?
  bufferBefore     Int     @default(0)
  bufferAfter      Int     @default(0)
  color            String
  isActive         Boolean @default(true)

  appointments     Appointment[]

  @@map("treatments")
}

// ============================================================
// APPOINTMENTS
// ============================================================
model Appointment {
  id                String   @id @default(cuid())
  clientId          String
  clientName        String
  operatorId        String
  operatorName      String
  treatmentId       String
  treatmentName     String
  treatmentCategory String
  roomId            String?
  locationId        String   @default("loc-1")
  date              String
  startTime         String
  endTime           String
  duration          Int
  status            String   @default("confirmed")
  price             Float
  services          Json?
  notes             String?
  cancelReason      String?
  cancelledAt       String?
  checkInAt         String?
  checkOutAt        String?
  isLocked          Boolean  @default(false)
  color             String
  createdAt         String
  updatedAt         String
  createdBy         String   @default("u1")

  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  operator          Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  treatment         Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

// ============================================================
// PACKAGES
// ============================================================
model Package {
  id             String  @id @default(cuid())
  name           String
  type           String
  price          Float
  totalSessions  Int
  sold           Int     @default(0)
  color          String
  description    String?
  treatmentName  String?

  clientPackages ClientPackage[]

  @@map("packages")
}

// ============================================================
// CLIENT PACKAGES
// ============================================================
model ClientPackage {
  id               String   @id @default(cuid())
  clientName       String
  packageName      String
  packageColor     String
  totalSessions    Int
  usedSessions     Int      @default(0)
  pricePaid        Float
  totalPaid        Float    @default(0)
  remainingBalance Float    @default(0)
  paymentPlan      String   @default("full")
  purchaseDate     String
  expiryDate       String
  status           String   @default("active")
  history          Json     @default("[]")
  payments         Json     @default("[]")

  packageId        String?
  package          Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("client_packages")
}

// ============================================================
// GIFT CARDS
// ============================================================
model GiftCard {
  id               String   @id @default(cuid())
  code             String   @unique
  purchasedBy      String
  recipientName    String
  recipientPhone   String?
  amount           Float
  remainingBalance Float
  purchaseDate     String
  expiryDate       String
  paymentMethod    String
  purchaseOperator String
  status           String   @default("active")
  message          String?
  transactions     Json     @default("[]")

  buyerId          String?
  buyer            Client?  @relation("GiftCardBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@map("gift_cards")
}

// ============================================================
// POS TRANSACTIONS
// ============================================================
model PosTransaction {
  id            String   @id @default(cuid())
  date          String
  time          String
  clientName    String?
  items         Json     @default("[]")
  productLines  Json?    // [{ productId, qty }] per lo scarico/ricarico magazzino
  total         Float
  paymentMethod String
  operator      String
  isRefund      Boolean  @default(false)
  refundReason  String?

  // C95 — scontrino fiscale elettronico
  c95Status      String? // pending | emitted | failed | uncertain | voided
  c95Emitted     Boolean @default(false)
  c95IdScontrino String?
  c95Gid         String?
  c95Idtrx       String?
  c95Progressivo String?
  c95Error       String?

  @@map("pos_transactions")
}

// ============================================================
// CASSAFORTE (movimenti: chiusure di cassa = versamenti, prelievi)
// I versamenti sono bloccati (non modificabili). Saldo = versamenti - prelievi.
// ============================================================
// Movimenti della CASSA CONTANTI (il cassetto): fondo cassa, spese, entrate/uscite
// manuali. Gli incassi in contanti arrivano dalle vendite POS, i versamenti in
// cassaforte sono registrati su CassaMovement.
model CashMovement {
  id        String  @id @default(cuid())
  kind      String  // 'in' | 'out'
  amount    Float
  category  String  @default("altro") // fondo | spesa | entrata | prelievo | correzione | altro
  note      String?
  operator  String  @default("")
  date      String  // giorno italiano YYYY-MM-DD
  createdAt String
  deletedAt String? // annullato: resta visibile nella cronologia (antifrode)
  deletedBy String?

  @@index([date])
  @@map("cash_movements")
}

model CassaMovement {
  id        String  @id @default(cuid())
  type      String  // 'deposit' (chiusura cassa) | 'withdraw' (prelievo)
  date      String  // giorno italiano YYYY-MM-DD
  cash      Float   @default(0) // contanti (l'importo che entra/esce dalla cassaforte)
  card      Float   @default(0)
  satispay  Float   @default(0)
  bonifico  Float   @default(0)
  total     Float   @default(0) // incasso totale della giornata (solo per i versamenti)
  txCount   Int     @default(0)
  note      String?
  createdAt String

  @@index([type])
  @@map("cassa_movements")
}

// ============================================================
// CHAT MESSAGES (chat clienti <-> operatrici)
// ============================================================
model ChatMessage {
  id             String  @id @default(cuid())
  clientId       String
  clientName     String
  sender         String  // 'client' | 'operator'
  body           String
  operatorName   String?
  readByOperator Boolean @default(false)
  readByClient   Boolean @default(false)
  createdAt      String

  @@index([clientId])
  @@map("chat_messages")
}

// ============================================================
// INAUGURATION LEADS (coupon "Nuova Apertura" dal sito)
// ============================================================
model InaugurationLead {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  phone        String  @unique // anti-doppione: una sola iscrizione per numero
  email        String
  treatment    String  // 'lampada' | 'pressoterapia' | 'body_sculpting'
  status       String  @default("pending") // 'pending' | 'confirmed'
  confirmToken String  @unique
  source       String? // es. 'qr-striscione'
  createdAt    String
  confirmedAt  String?

  @@index([status])
  @@index([email])
  @@map("inauguration_leads")
}

// ============================================================
// ACCOUNT GESTIONALE (accessi al gestionale + ruoli/permessi)
// Condivisi via DB così valgono su tutti i dispositivi.
// ============================================================
model AppRole {
  id          String  @id @default(cuid())
  name        String
  color       String
  isSystem    Boolean @default(false)
  permissions Json    @default("{}")
  sortOrder   Int     @default(0)

  @@map("app_roles")
}

model AppUser {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  roleId    String
  active    Boolean @default(true)
  createdAt String

  @@index([email])
  @@map("app_users")
}

// ============================================================
// RUBRICA CONTATTI (fornitori, professionisti, servizi)
// ============================================================
model BusinessContact {
  id        String  @id @default(cuid())
  name      String
  role      String  @default("") // Commercialista, Programmatore, HR, Fornitore...
  category  String  @default("professionisti")
  company   String  @default("")
  phone     String  @default("")
  email     String  @default("")
  website   String  @default("")
  address   String  @default("")
  vatNumber String  @default("")
  notes     String  @default("")
  favorite  Boolean @default(false)
  createdAt String
  updatedAt String

  @@index([category])
  @@map("business_contacts")
}

// ============================================================
// MOVIMENTI DI MAGAZZINO (scarichi e carichi con motivo)
// ============================================================
model StockMovement {
  id          String  @id @default(cuid())
  productId   String
  productName String
  kind        String  @default("out") // out = scarico | in = carico
  quantity    Int     // quantità movimentata (sempre positiva)
  reason      String  @default("") // motivo: uso interno, scaduto, rotto, omaggio, correzione...
  note        String  @default("")
  operator    String  @default("")
  stockAfter  Int     // giacenza risultante
  date        String  // giorno italiano YYYY-MM-DD
  createdAt   String

  @@index([productId])
  @@index([date])
  @@map("stock_movements")
}

// ============================================================
// TURNI PER SETTIMANA (ogni settimana ha i suoi orari)
// ============================================================
model OperatorWeekSchedule {
  id         String @id @default(cuid())
  operatorId String
  weekStart  String // lunedì della settimana, YYYY-MM-DD
  schedule   Json   // { [dow 1..6]: { isWorking, startTime, endTime, breakStart?, breakEnd? } }
  updatedAt  String

  @@unique([operatorId, weekStart])
  @@index([weekStart])
  @@map("operator_week_schedules")
}
