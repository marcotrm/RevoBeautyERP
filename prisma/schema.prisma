generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CLIENTS
// ============================================================
model Client {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String
  birthDate        String?
  gender           String?
  address          String?
  city             String?
  notes            String?
  privateNotes     String?
  allergies        String?
  preferences      String[] @default([])
  tags             String[] @default([])
  vipLevel         Int      @default(0)
  loyaltyPoints    Int      @default(0)
  cashback         Float    @default(0)
  gdprConsent      Boolean  @default(true)
  marketingConsent Boolean  @default(false)
  avatar           String?
  createdAt        String
  lastVisit        String?
  totalSpent       Float    @default(0)
  visitCount       Int      @default(0)
  avgTicket        Float    @default(0)
  referredBy       String?
  customTreatments Json     @default("[]")
  priceListId      String?
  medicalRecord    Json? // anamnesi / scheda tecnica estetica

  appointments       Appointment[]
  clientPackages     ClientPackage[]
  giftCardsPurchased GiftCard[]       @relation("GiftCardBuyer")
  mobileAccount      MobileAccount?
  photos             ClientPhoto[]
  consents           ClientConsent[]
  documents          ClientDocument[]

  @@map("clients")
}

// Foto (prima/dopo) e documenti del cliente — immagine in base64 compressa lato client.
model ClientPhoto {
  id        String  @id @default(cuid())
  clientId  String
  kind      String  @default("before") // before | after | document
  data      String // data URL base64
  label     String?
  treatment String?
  createdAt String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_photos")
}

// Consensi firmati del cliente (privacy, trattamento, ...) con firma opzionale.
model ClientConsent {
  id            String  @id @default(cuid())
  clientId      String
  title         String
  signatureData String? // firma disegnata in base64 (opzionale)
  signedAt      String
  notes         String?
  /// Le risposte del modulo, quando il consenso nasce da un questionario e non
  /// da una riga scritta a mano: per il laser sono lo storico dichiarato dalla
  /// cliente, le zone concordate e la firma dell'operatrice.
  data          Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_consents")
}

// ============================================================
// MOBILE ACCOUNTS (account di accesso dell'app clienti)
// ============================================================
/**
 * Accesso della cliente all'app.
 * Si entra col numero di telefono e un codice usa-e-getta su WhatsApp: nessuna
 * password da ricordare e il numero è già in anagrafica, quindi l'account nasce
 * automaticamente collegato alla scheda giusta. Email e password restano
 * facoltative per non chiudere la porta a un accesso alternativo in futuro.
 */
model MobileAccount {
  id           String  @id @default(cuid())
  /**
   * Numero normalizzato (solo cifre, con prefisso): è la chiave d'accesso.
   */
  phone        String  @unique
  email        String? @unique
  passwordHash String?
  sessionToken String? @unique
  /**
   * Ultimo accesso riuscito, per capire chi usa davvero l'app.
   */
  lastLoginAt  String?
  createdAt    String

  /**
   * Codice usa-e-getta: si salva l'hash, mai il codice in chiaro.
   */
  otpHash      String?
  otpExpiresAt String?
  otpAttempts  Int     @default(0)
  /**
   * Quando è partito l'ultimo codice: serve a non farne mandare a raffica.
   */
  otpSentAt    String?

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("mobile_accounts")
}

// ============================================================
// OPERATORS
// ============================================================
model Operator {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  avatar             String?
  color              String
  specializations    String[] @default([])
  locationIds        String[] @default([])
  schedule           Json     @default("{}")
  contractHours      Float    @default(0)
  isActive           Boolean  @default(true)
  phone              String?
  email              String?
  /// Percentuale sui trattamenti che esegue lei.
  commission         Float    @default(0)
  /// Percentuale sui prodotti che vende: di solito piu' alta dei trattamenti,
  /// perche' il prodotto lo si vende solo se lo si propone.
  commissionProdotti Float    @default(0)
  /// Da quanto fatturato in su scatta la percentuale piu' alta (0 = mai).
  commissionSoglia   Float    @default(0)
  /// La percentuale oltre la soglia: il premio di chi tira il mese.
  commissionOltre    Float    @default(0)
  /// Il fisso mensile che prende comunque, al lordo (0 = solo provvigione).
  compensoFisso      Float    @default(0)
  hireDate           String
  isResource         Boolean  @default(false) // true = cabina/macchinario prenotabile senza operatrice
  monthlyCost        Float    @default(0) // costo mensile lordo azienda (per calcolare il costo orario)

  appointments Appointment[]

  @@map("operators")
}

// ============================================================
// AMMINISTRAZIONE (costi fissi/variabili, investimenti, cash flow, obiettivi, financials)
// Record condivisi salvati come JSON, distinti per "kind".
// ============================================================
model AdminEntry {
  rowId     String @id
  kind      String
  entityId  String
  data      Json
  createdAt String

  @@index([kind])
  @@map("admin_entries")
}

// ============================================================
// MAGAZZINO (prodotti)
// ============================================================
model Product {
  id         String  @id @default(cuid())
  name       String
  brand      String  @default("")
  category   String  @default("Viso")
  sku        String  @default("")
  barcode    String?
  price      Float   @default(0)
  costPrice  Float   @default(0)
  stock      Int     @default(0)
  minStock   Int     @default(5)
  locationId String  @default("loc1")
  isActive   Boolean @default(true)
  createdAt  String  @default("")
  /// Foto del prodotto (data-URI compressa): la vetrina dei regali la mostra
  image      String?

  @@map("products")
}

// ============================================================
// SPESE SOCI (anticipi dei soci, dare/avere)
// ============================================================
model PartnerExpense {
  id          String @id @default(cuid())
  partner     String
  amount      Float
  description String
  date        String
  createdAt   String

  @@map("partner_expenses")
}

// ============================================================
// TO-DO (cose da fare)
// ============================================================
model TodoItem {
  id          String  @id @default(cuid())
  title       String
  list        String  @default("todo") // todo | shopping (cose da comprare)
  done        Boolean @default(false)
  priority    String  @default("normal") // low | normal | high
  dueDate     String?
  assignee    String?
  createdAt   String
  completedAt String?

  @@map("todo_items")
}

// ============================================================
// AGENDA BLOCKS (fasce orarie bloccate: pause, chiusure)
// ============================================================
model AgendaBlock {
  id         String  @id @default(cuid())
  operatorId String
  date       String
  startTime  String
  endTime    String
  reason     String?
  createdAt  String

  @@map("agenda_blocks")
}

// ============================================================
// TREATMENTS
// ============================================================
model Treatment {
  id                String  @id @default(cuid())
  name              String
  category          String
  duration          Int
  price             Float
  priceMale         Float?
  priceFemale       Float?
  durationMale      Int?
  durationFemale    Int?
  description       String?
  requiresRoom      Boolean @default(false)
  requiresEquipment String?
  bufferBefore      Int     @default(0)
  bufferAfter       Int     @default(0)
  /// Minuti di preparazione che il trattamento si porta dietro (cabina da
  /// allestire, prodotto da stendere, macchinario da scaldare). Alla cliente
  /// si dice la durata qui sopra; in agenda il posto occupato è la somma.
  preparazione      Int     @default(0)
  color             String
  isActive          Boolean @default(true)
  /// Chi lo esegue e con che tempi: [{ operatorId, duration, price? }].
  /// Vuoto o assente = lo fanno tutte, con la durata standard qui sopra.
  operatorSkills    Json?

  appointments Appointment[]

  @@map("treatments")
}

// ============================================================
// APPOINTMENTS
// ============================================================
model Appointment {
  id                String  @id @default(cuid())
  clientId          String
  clientName        String
  operatorId        String
  operatorName      String
  treatmentId       String
  treatmentName     String
  treatmentCategory String
  roomId            String?
  locationId        String  @default("loc-1")
  date              String
  startTime         String
  endTime           String
  duration          Int
  status            String  @default("confirmed")
  price             Float
  services          Json?
  notes             String?
  cancelReason      String?
  cancelledAt       String?
  checkInAt         String?
  checkOutAt        String?
  /**
   * Cabina scelta al check-in ("4"): è quella che l'annuncio vocale chiama a fine trattamento.
   */
  cabinNumber       String?
  isLocked          Boolean @default(false)
  /// Sconto concordato sulla seduta: quanto è stato tolto dal totale e perché.
  /// `price` resta il prezzo FINALE, quello che la cliente paga davvero, così
  /// incasso previsto, cassa e statistiche non vanno corretti da nessuna parte.
  discountAmount    Float?
  discountReason    String?
  /// Chi ha deciso il prezzo diverso: serve a chi guarda i conti a fine mese,
  /// non a controllare le persone — ma senza, uno sconto è di nessuno.
  discountBy        String?
  /// Seduta già pagata prima del giorno, di solito da qualcun altro: il padre
  /// che passa e paga il trattamento della figlia per la settimana dopo. Dentro
  /// c'è la riga di cassa dove i soldi sono entrati davvero (o la nota di chi
  /// li ha presi), così al check-out non si incassa una seconda volta e chi è
  /// al banco quel giorno lo sa senza aver parlato con nessuno.
  paidAhead         Json?
  /// La caparra: quanto e' stato chiesto, se e' arrivata e che fine ha fatto.
  /// { richiesta, stato: attesa|pagata|trattenuta|restituita|usata, metodo,
  ///   link, chiestaIl, pagataIl, scadenza, txId, nota }
  caparra           Json?
  color             String
  createdAt         String
  updatedAt         String
  createdBy         String  @default("u1")

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  operator  Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

// ============================================================
// PACKAGES
// ============================================================
model Package {
  id            String  @id @default(cuid())
  name          String
  type          String
  price         Float
  totalSessions Int
  sold          Int     @default(0)
  color         String
  description   String?
  treatmentName String?

  clientPackages ClientPackage[]

  @@map("packages")
}

// ============================================================
// CLIENT PACKAGES
// ============================================================
model ClientPackage {
  id               String @id @default(cuid())
  clientName       String
  packageName      String
  packageColor     String
  totalSessions    Int
  usedSessions     Int    @default(0)
  pricePaid        Float
  totalPaid        Float  @default(0)
  remainingBalance Float  @default(0)
  paymentPlan      String @default("full")
  purchaseDate     String
  expiryDate       String
  status           String @default("active")
  history          Json   @default("[]")
  payments         Json   @default("[]")

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("client_packages")
}

// ============================================================
// GIFT CARDS
// ============================================================
model GiftCard {
  id               String  @id @default(cuid())
  code             String  @unique
  purchasedBy      String
  recipientName    String
  recipientPhone   String?
  amount           Float
  remainingBalance Float
  purchaseDate     String
  expiryDate       String
  paymentMethod    String
  purchaseOperator String
  status           String  @default("active")
  message          String?
  transactions     Json    @default("[]")

  buyerId String?
  buyer   Client? @relation("GiftCardBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@map("gift_cards")
}

// ============================================================
// POS TRANSACTIONS
// ============================================================
model PosTransaction {
  id            String  @id @default(cuid())
  date          String
  time          String
  clientName    String?
  /// L'appuntamento incassato con questa vendita, quando arriva dal check-out.
  /// Senza questo legame un appuntamento "completato" non sapeva dire se i
  /// soldi fossero stati presi davvero.
  appointmentId String?
  items         Json    @default("[]")
  productLines  Json? // [{ productId, qty }] per lo scarico/ricarico magazzino
  total         Float
  paymentMethod String
  operator      String
  isRefund      Boolean @default(false)
  refundReason  String?

  // C95 — scontrino fiscale elettronico
  c95Status      String? // pending | emitted | failed | uncertain | voided
  c95Emitted     Boolean @default(false)
  c95IdScontrino String?
  c95Gid         String?
  c95Idtrx       String?
  c95Progressivo String?
  c95Error       String?

  @@map("pos_transactions")
}

// ============================================================
// CASSAFORTE (movimenti: chiusure di cassa = versamenti, prelievi)
// I versamenti sono bloccati (non modificabili). Saldo = versamenti - prelievi.
// ============================================================
// Movimenti della CASSA CONTANTI (il cassetto): fondo cassa, spese, entrate/uscite
// manuali. Gli incassi in contanti arrivano dalle vendite POS, i versamenti in
// cassaforte sono registrati su CassaMovement.
model CashMovement {
  id        String  @id @default(cuid())
  kind      String // 'in' | 'out'
  amount    Float
  category  String  @default("altro") // fondo | spesa | entrata | prelievo | correzione | altro
  note      String?
  operator  String  @default("")
  date      String // giorno italiano YYYY-MM-DD
  createdAt String
  deletedAt String? // annullato: resta visibile nella cronologia (antifrode)
  deletedBy String?

  @@index([date])
  @@map("cash_movements")
}

model CassaMovement {
  id        String  @id @default(cuid())
  type      String // 'deposit' (chiusura cassa) | 'withdraw' (prelievo)
  date      String // giorno italiano YYYY-MM-DD
  cash      Float   @default(0) // contanti (l'importo che entra/esce dalla cassaforte)
  card      Float   @default(0)
  satispay  Float   @default(0)
  bonifico  Float   @default(0)
  total     Float   @default(0) // incasso totale della giornata (solo per i versamenti)
  txCount   Int     @default(0)
  note      String?
  createdAt String

  @@index([type])
  @@map("cassa_movements")
}

// ============================================================
// CHAT MESSAGES (chat clienti <-> operatrici)
// ============================================================
model ChatMessage {
  id             String  @id @default(cuid())
  clientId       String
  clientName     String
  sender         String // 'client' | 'operator'
  body           String
  operatorName   String?
  readByOperator Boolean @default(false)
  readByClient   Boolean @default(false)
  createdAt      String

  @@index([clientId])
  @@map("chat_messages")
}

// ============================================================
// INAUGURATION LEADS (coupon "Nuova Apertura" dal sito)
// ============================================================
model InaugurationLead {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  phone        String  @unique // anti-doppione: una sola iscrizione per numero
  email        String
  treatment    String // 'lampada' | 'pressoterapia' | 'body_sculpting'
  status       String  @default("pending") // 'pending' | 'confirmed'
  confirmToken String  @unique
  source       String? // es. 'qr-striscione'
  createdAt    String
  confirmedAt  String?

  @@index([status])
  @@index([email])
  @@map("inauguration_leads")
}

// ============================================================
// CONTATTI INTERESSATI (form del sito, app, QR)
// ============================================================
/**
 * Chi ha lasciato i suoi dati senza essere ancora cliente.
 * Prima non esisteva: il modulo del sito faceva finta di inviare — il tasto
 * diventava verde e il messaggio non partiva da nessuna parte — quindi ogni
 * richiesta arrivata da revobeauty.it si e' persa nel momento in cui la
 * persona chiudeva la pagina. Un contatto perso non fa rumore, ed e' questo
 * che lo rende caro.
 * Il lead resta separato dalla scheda cliente finche' non prenota davvero:
 * riempire la rubrica di schede vuote di gente che ha solo fatto una domanda
 * sporca le statistiche e i richiami automatici. Quando prenota, `clientId`
 * lega le due cose.
 */
model Lead {
  id               String  @id @default(cuid())
  firstName        String
  lastName         String  @default("")
  /**
   * Normalizzato internazionale (393331234567): e' la chiave con cui si parla su WhatsApp.
   */
  phone            String  @default("")
  email            String  @default("")
  /**
   * Il servizio scelto nel modulo, come lo ha scritto il sito.
   */
  service          String  @default("")
  message          String  @default("")
  /**
   * sito | app | qr | telefono | manuale
   */
  source           String  @default("sito")
  /**
   * Da quale pagina e' arrivato: serve a capire cosa converte.
   */
  page             String  @default("")
  /**
   * nuovo | contattato | in_chat | prenotato | cliente | perso
   */
  status           String  @default("nuovo")
  privacyConsent   Boolean @default(false)
  marketingConsent Boolean @default(false)
  clientId         String?
  appointmentId    String?
  /**
   * Quando gli e' partito il primo messaggio WhatsApp.
   */
  contactedAt      String?
  notes            String  @default("")
  createdAt        String
  updatedAt        String

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("leads")
}

// ============================================================
// ACCOUNT GESTIONALE (accessi al gestionale + ruoli/permessi)
// Condivisi via DB così valgono su tutti i dispositivi.
// ============================================================
model AppRole {
  id          String  @id @default(cuid())
  name        String
  color       String
  isSystem    Boolean @default(false)
  permissions Json    @default("{}")
  sortOrder   Int     @default(0)

  @@map("app_roles")
}

/**
 * Chi entra nel gestionale, e quando.
 * Non c'era niente: `authenticate` confrontava la password e tornava
 * l'account, senza lasciare traccia. Il giorno in cui serve sapere se un
 * account che non deve piu' entrare sta ancora entrando — un socio uscito, una
 * ragazza che se n'e' andata — non c'e' niente da guardare, e il passato non
 * si ricostruisce.
 * Si registrano anche i tentativi FALLITI: qualcuno che prova la password
 * sbagliata dieci volte alle tre di notte e' un'informazione, e senza le
 * righe fallite si vedrebbe solo il silenzio.
 */
model LoginLog {
  id             String  @id @default(cuid())
  /**
   * L'email digitata: c'e' anche quando l'account non esiste.
   */
  email          String
  /**
   * L'account, quando l'accesso e' riuscito.
   */
  userId         String?
  nome           String?
  ruolo          String?
  esito          String // ok | password_errata | account_spento | inesistente
  ip             String?
  userAgent      String?
  createdAt      String
  /**
   * L'ultimo battito arrivato dal browser: dice fin quando e' rimasto dentro.
   */
  ultimaAttivita String?
  /**
   * I minuti di uso vero, sommati battito dopo battito (le pause non contano).
   */
  minuti         Int     @default(0)

  @@index([email])
  @@index([createdAt])
  @@map("login_logs")
}

model AppUser {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  roleId    String
  active    Boolean @default(true)
  createdAt String

  @@index([email])
  @@map("app_users")
}

// ============================================================
// RUBRICA CONTATTI (fornitori, professionisti, servizi)
// ============================================================
model BusinessContact {
  id        String  @id @default(cuid())
  name      String
  role      String  @default("") // Commercialista, Programmatore, HR, Fornitore...
  category  String  @default("professionisti")
  company   String  @default("")
  phone     String  @default("")
  email     String  @default("")
  website   String  @default("")
  address   String  @default("")
  vatNumber String  @default("")
  notes     String  @default("")
  favorite  Boolean @default(false)
  createdAt String
  updatedAt String

  @@index([category])
  @@map("business_contacts")
}

// ============================================================
// MOVIMENTI DI MAGAZZINO (scarichi e carichi con motivo)
// ============================================================
model StockMovement {
  id          String @id @default(cuid())
  productId   String
  productName String
  kind        String @default("out") // out = scarico | in = carico
  quantity    Int // quantità movimentata (sempre positiva)
  reason      String @default("") // motivo: uso interno, scaduto, rotto, omaggio, correzione...
  note        String @default("")
  operator    String @default("")
  stockAfter  Int // giacenza risultante
  date        String // giorno italiano YYYY-MM-DD
  createdAt   String

  @@index([productId])
  @@index([date])
  @@map("stock_movements")
}

// ============================================================
// TURNI PER SETTIMANA (ogni settimana ha i suoi orari)
// ============================================================
model OperatorWeekSchedule {
  id         String @id @default(cuid())
  operatorId String
  weekStart  String // lunedì della settimana, YYYY-MM-DD
  schedule   Json // { [dow 1..6]: { isWorking, startTime, endTime, breakStart?, breakEnd? } }
  updatedAt  String

  @@unique([operatorId, weekStart])
  @@index([weekStart])
  @@map("operator_week_schedules")
}

// ============================================================
// DOCUMENTI DI IDENTITA'
// Sul consenso serve il numero del documento. Prima lo si copiava a mano dal
// tesserino, con gli errori di chi trascrive: la cliente fotografa il
// documento, il gestionale legge i dati e la foto resta allegata alla
// compilazione — cosi' chi la riapre vede da dove esce quel numero.
// ============================================================
model ClientDocument {
  id          String  @id @default(cuid())
  clientId    String
  /// carta_identita | patente | passaporto | altro
  tipo        String  @default("altro")
  numero      String
  nome        String?
  cognome     String?
  dataNascita String?
  scadenza    String?
  /// La foto, come data URL compressa: e' la prova di dove esce il numero.
  foto        String
  /// Una miniatura da 320px: l'elenco ne mostra decine tutte insieme, e con
  /// le foto intere sarebbero decine di megabyte per aprire una pagina.
  anteprima   String?
  /// Il consenso a cui era allegato, quando nasce di li'.
  consensoId  String?
  /// Chi l'ha caricato: la cliente dal modulo, o l'operatrice dal banco.
  origine     String  @default("cliente")
  createdAt   String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@map("client_documents")
}

// ============================================================
// ABBONAMENTI (rinnovo mensile)
// Il pacchetto a sedute finisce; l'abbonamento no: si rinnova ogni mese
// finche' qualcuno lo ferma. E' l'unica voce che rende prevedibile il
// fatturato, perche' a inizio mese si sa gia' quanto entrera'.
// ============================================================
model Subscription {
  id              String   @id @default(cuid())
  clientId        String?
  clientName      String
  nome            String
  prezzoMensile   Float
  /// Quante sedute al mese sono comprese. 0 = illimitate.
  seduteAlMese    Int      @default(0)
  /// Quante ne ha gia' fatte in questo mese di abbonamento.
  seduteUsate     Int      @default(0)
  /// Cosa comprende: categorie e/o trattamenti precisi.
  categorie       String[] @default([])
  trattamenti     String[] @default([])
  inizio          String
  /// Il giorno del prossimo pagamento: e' la data che conta.
  prossimoRinnovo String
  stato           String   @default("attivo") // attivo | sospeso | chiuso
  /// Lo storico dei rinnovi incassati: [{data, importo, metodo, txId, operatore}]
  incassi         Json     @default("[]")
  note            String?
  createdAt       String
  updatedAt       String

  @@index([clientId])
  @@index([prossimoRinnovo])
  @@map("subscriptions")
}

// ============================================================
// ORDINI PRODOTTI (ritiro in centro)
// La crema si vende solo a chi passa dal banco e se la ricorda. Con l'ordine
// online la cliente la mette da parte quando le viene in mente — la sera, dal
// divano — e la ritira al prossimo appuntamento. Niente spedizioni: nessun
// corriere, nessun reso, nessun pagamento anticipato.
// ============================================================
model ProductOrder {
  id         String  @id @default(cuid())
  numero     Int     @default(autoincrement())
  clientId   String?
  clientName String
  phone      String
  email      String?
  /// [{ productId, nome, prezzo, qty }]
  righe      Json
  totale     Float
  /// nuovo | pronto | ritirato | annullato
  stato      String  @default("nuovo")
  note       String?
  /// La riga di cassa, quando viene ritirato e pagato.
  txId       String?
  createdAt  String
  updatedAt  String

  @@index([stato])
  @@index([createdAt])
  @@map("product_orders")
}

// ============================================================
// AFFILIAZIONE TRAMITE QR CODE
// Ogni attività partner (bar, palestra, parrucchiere...) ha uno o più QR
// personali: chi li scansiona atterra su una pagina Revobeauty brandizzata,
// si registra con verifica OTP su WhatsApp e riceve un voucher per il
// trattamento gratuito. Il cliente resta legato per sempre all'affiliato
// che l'ha portato, e su ogni suo incasso matura la commissione.
// ============================================================
model Affiliate {
  id                String  @id @default(cuid())
  code              String  @unique // codice affiliato leggibile (es. BAR-ROSSI)
  businessName      String // nome attività mostrato sulla landing
  contactName       String?
  phone             String?
  email             String?
  commissionPercent Float   @default(10)
  portalToken       String  @unique // link segreto del portale affiliato
  isActive          Boolean @default(true)
  notes             String?
  createdAt         String

  qrs   AffiliateQr[]
  leads AffiliateLead[]

  @@map("affiliates")
}

model AffiliateQr {
  id          String  @id @default(cuid())
  slug        String  @unique // finisce nell'URL: corto e non indovinabile
  affiliateId String
  name        String // nome interno: "Espositore banco", "Volantino"...
  channel     String? // canale/campagna di provenienza
  treatment   String // trattamento gratuito offerto
  message     String? // messaggio personalizzato sulla landing
  conditions  String? // condizioni dell'offerta
  status      String  @default("active") // draft|active|suspended|expired|disabled|blocked
  expiresAt   String? // YYYY-MM-DD, dopo questa data non accetta registrazioni
  maxUses     Int? // massimo di registrazioni verificate
  replacesId  String? // QR che questo sostituisce (lo storico resta sul vecchio)
  createdAt   String

  affiliate Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  scans     AffiliateScan[]
  leads     AffiliateLead[]

  @@index([affiliateId])
  @@map("affiliate_qrs")
}

model AffiliateScan {
  id        String  @id @default(cuid())
  qrId      String
  visitorId String? // id anonimo salvato sul telefono: serve per le scansioni uniche
  device    String? // "iPhone", "Android", "Computer"
  at        String // ISO

  qr AffiliateQr @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@map("affiliate_scans")
}

model AffiliateLead {
  id            String  @id @default(cuid())
  qrId          String
  affiliateId   String
  firstName     String
  lastName      String
  phone         String // normalizzato con prefisso (39...)
  email         String?
  status        String  @default("otp") // otp = in attesa del codice | verified | blocked
  blockReason   String? // gia_cliente | doppione | auto_registrazione | qr_non_valido
  otpCode       String?
  otpExpiresAt  String? // ISO
  otpAttempts   Int     @default(0)
  voucherCode   String? @unique // buono del trattamento gratuito
  voucherUsedAt String? // quando l'omaggio è stato consumato in negozio
  clientId      String? // cliente in anagrafica creato/collegato alla verifica
  visitorId     String?
  device        String?
  createdAt     String // ISO
  verifiedAt    String? // ISO

  qr        AffiliateQr @relation(fields: [qrId], references: [id], onDelete: Cascade)
  affiliate Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([affiliateId])
  // Si cerca a ogni incasso per sapere se quella cliente è di un affiliato:
  // senza indice sarebbe una scansione della tabella dentro alla cassa.
  @@index([clientId])
  @@map("affiliate_leads")
}

// ============================================================
// AUTOCLAVE (registro disinfezioni serali degli attrezzi)
// Ogni sera si registra il ciclo: chi l'ha fatto, quando, quanti
// pezzi. È il registro da esibire ai controlli: le righe non hanno
// FK verso l'operatrice, il nome resta scritto anche se un giorno
// l'operatrice viene tolta dall'anagrafica.
// ============================================================
model AutoclaveCycle {
  id           String  @id @default(cuid())
  date         String // giorno italiano YYYY-MM-DD
  operatorId   String
  operatorName String
  pieces       Int // pezzi inseriti nella macchina
  notes        String?
  createdAt    String // ISO

  @@index([date])
  @@map("autoclave_cycles")
}

// ============================================================
// APP CLIENTI — fondamenta condivise
// Punti, credito, configurazioni e tracciamento: su queste poggiano
// Beauty Club, Beauty Box, Challenge, Referral e le statistiche dell'app.
// ============================================================

/**
 * Ogni movimento di punti o di credito, mai un saldo scritto a mano.
 * Un saldo da solo non si può spiegare né correggere: alla prima cliente che
 * dice "io avevo 40 punti" non c'è modo di sapere chi ha ragione. Qui il saldo
 * è la somma dei movimenti, e ogni movimento dice da dove viene.
 * Il credito è diviso in "tasche" (acquistato, cashback, promozionale,
 * referral...) perché hanno regole diverse: quello acquistato è denaro della
 * cliente e non scade mai, quello promozionale è uno sconto travestito e scade.
 * Si consuma sempre prima quello che scade prima.
 */
model LoyaltyMovement {
  id         String  @id @default(cuid())
  clientId   String
  /**
   * points = punti fedeltà · credit = euro nel wallet
   */
  kind       String
  /**
   * Positivo se entra, negativo se esce. In euro per il credito.
   */
  amount     Float
  /**
   * Tasca del credito: purchased | cashback | promo | referral | compensation | prize
   */
  bucket     String  @default("purchased")
  /**
   * Testo mostrato alla cliente nello storico ("Cashback trattamento").
   */
  reason     String
  /**
   * Da dove nasce: appointment | pos | referral | challenge | prize | manual | topup | expiry
   */
  sourceType String
  sourceId   String?
  /**
   * Solo per le entrate che scadono. Null = non scade.
   */
  expiresAt  String?
  /**
   * Quanto di questa entrata è già stato consumato (in euro/punti).
   */
  consumed   Float   @default(0)
  createdAt  String
  /**
   * Chi l'ha generato, quando è un movimento fatto a mano dallo staff.
   */
  operator   String?

  @@index([clientId, kind])
  @@index([expiresAt])
  @@map("loyalty_movements")
}

/**
 * Configurazioni dell'app clienti, modificabili dal gestionale.
 * Sta qui tutto ciò che non deve richiedere una modifica al codice per
 * cambiare: interruttori delle funzioni, percentuali di cashback, regole dei
 * Flash Slot, testi. Una riga per argomento, il contenuto è JSON perché ogni
 * argomento ha una forma sua.
 */
model AppSetting {
  key       String @id
  data      Json
  updatedAt String

  @@map("app_settings")
}

/**
 * Cosa succede dentro l'app, passo per passo.
 * Serve a rispondere alla domanda che conta: quanto fattura ogni funzione.
 * Senza registrare anche le viste e i clic si sa solo quante prenotazioni
 * sono arrivate, non quante occasioni sono state buttate.
 */
model AppEvent {
  id        String  @id @default(cuid())
  clientId  String?
  /**
   * view | click | booking | completed | revenue
   */
  type      String
  /**
   * Da dove: home | per_te | flash_slot | referral | challenge | push | wallet | box
   */
  surface   String
  /**
   * Oggetto specifico (id dello slot, della challenge, del premio...).
   */
  itemId    String?
  /**
   * Valore in euro, per gli eventi che ne producono.
   */
  value     Float?
  meta      Json?
  createdAt String

  @@index([type, surface])
  @@index([clientId])
  @@index([createdAt])
  @@map("app_events")
}

/**
 * Livelli del Beauty Club, decisi dal gestionale e non dal codice.
 * Soglie, nomi e vantaggi cambiano con le stagioni e con le promozioni: se
 * fossero scritti nel codice, cambiare "Gold da 500 a 600 euro" richiederebbe
 * un rilascio.
 */
model ClubLevel {
  id           String   @id @default(cuid())
  name         String
  /**
   * Spesa totale da cui scatta il livello.
   */
  minSpent     Float    @default(0)
  /**
   * Visite completate richieste, in alternativa alla spesa.
   */
  minVisits    Int      @default(0)
  color        String   @default("#B76E79")
  /**
   * Percentuale di cashback riconosciuta a questo livello.
   */
  cashbackPct  Float    @default(0)
  /**
   * Moltiplicatore dei punti (1 = normale, 2 = doppi).
   */
  pointsFactor Float    @default(1)
  /**
   * Minuti di anticipo sui Flash Slot rispetto agli altri livelli.
   */
  flashHeadMin Int      @default(0)
  /**
   * Vantaggi descritti a parole, mostrati nell'app.
   */
  perks        String[] @default([])
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)

  @@map("club_levels")
}

/**
 * Obiettivi a tempo con un premio: "3 appuntamenti entro settembre".
 */
model Challenge {
  id          String  @id @default(cuid())
  title       String
  description String
  /**
   * appointments | bookings_app | referrals | packages | reviews | spend
   */
  goalType    String
  goalCount   Float
  /**
   * credit | points | prize | free_treatment
   */
  rewardType  String
  rewardValue Float   @default(0)
  /**
   * Descrizione del premio mostrata alla cliente.
   */
  rewardLabel String
  startsAt    String
  endsAt      String
  isActive    Boolean @default(true)
  createdAt   String

  progress ChallengeProgress[]

  @@map("challenges")
}

model ChallengeProgress {
  id            String  @id @default(cuid())
  challengeId   String
  clientId      String
  count         Float   @default(0)
  completedAt   String?
  rewardGivenAt String?
  updatedAt     String

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, clientId])
  @@index([clientId])
  @@map("challenge_progress")
}

/**
 * Premi della Beauty Box.
 * `weight` è il peso nell'estrazione, non una percentuale: così si aggiunge un
 * premio senza dover ribilanciare a mano tutti gli altri perché la somma torni
 * a cento.
 */
model Prize {
  id          String  @id @default(cuid())
  name        String
  /**
   * credit | points | free_treatment | discount
   */
  kind        String
  value       Float   @default(0)
  /**
   * Trattamento regalato, quando kind = free_treatment.
   */
  treatmentId String?
  weight      Int     @default(1)
  /**
   * Pezzi disponibili. Null = illimitato.
   */
  stock       Int?
  /**
   * Giorni di validità del premio una volta vinto.
   */
  validDays   Int     @default(30)
  isActive    Boolean @default(true)
  createdAt   String

  wins PrizeWin[]

  @@map("prizes")
}

model PrizeWin {
  id        String  @id @default(cuid())
  clientId  String
  prizeId   String
  /**
   * Perché è stata assegnata: challenge | streak | referral | manual
   */
  reason    String
  openedAt  String?
  usedAt    String?
  expiresAt String
  createdAt String

  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("prize_wins")
}

/**
 * Posti liberati in agenda e messi in vetrina nell'app.
 * Nasce da una disdetta o da un buco che nessuno riempirebbe. Chi prenota per
 * primo se lo prende: l'assegnazione avviene con un aggiornamento condizionato
 * (`status = 'open'` nella clausola WHERE), che il database esegue in modo
 * atomico. Due clienti che premono nello stesso istante non possono vincere
 * entrambe: la seconda riceve zero righe modificate e un messaggio chiaro,
 * invece di un doppio appuntamento in agenda.
 */
model FlashSlot {
  id              String  @id @default(cuid())
  date            String
  startTime       String
  endTime         String
  treatmentId     String
  treatmentName   String
  operatorId      String
  operatorName    String
  /**
   * Prezzo pieno e prezzo scontato dello slot.
   */
  fullPrice       Float
  price           Float
  /**
   * Fino a quando resta in vetrina.
   */
  expiresAt       String
  /**
   * open | taken | expired | cancelled
   */
  status          String  @default("open")
  takenByClientId String? @unique
  takenAt         String?
  appointmentId   String?
  /**
   * Livello minimo del Beauty Club che lo vede subito.
   */
  minLevelOrder   Int     @default(0)
  createdAt       String
  createdBy       String?

  @@index([status, date])
  @@map("flash_slots")
}

/**
 * Codice personale di ogni cliente per invitare le amiche.
 */
model ReferralCode {
  clientId  String @id
  code      String @unique
  createdAt String

  @@map("referral_codes")
}

/**
 * Un invito e come è andato a finire.
 * Il premio matura solo quando l'amica diventa cliente pagante: promettere
 * credito alla registrazione trasforma il referral in una macchina per creare
 * account finti.
 */
model Referral {
  id              String  @id @default(cuid())
  inviterClientId String
  invitedName     String?
  invitedPhone    String
  /**
   * invited | registered | converted | blocked
   */
  status          String  @default("invited")
  blockReason     String?
  invitedClientId String?
  /**
   * Premi già riconosciuti, per non pagarli due volte.
   */
  inviterRewardAt String?
  invitedRewardAt String?
  createdAt       String
  convertedAt     String?

  @@index([inviterClientId])
  @@index([invitedPhone])
  @@map("referrals")
}

/**
 * Centro, operatrice e trattamenti preferiti: alimentano le proposte.
 */
model ClientFavorite {
  id        String @id @default(cuid())
  clientId  String
  /**
   * operator | treatment | location
   */
  kind      String
  refId     String
  label     String
  createdAt String

  @@unique([clientId, kind, refId])
  @@index([clientId])
  @@map("client_favorites")
}

/**
 * Telefono su cui mandare le notifiche push.
 */
model DeviceToken {
  id         String @id @default(cuid())
  clientId   String
  token      String @unique
  platform   String
  createdAt  String
  lastSeenAt String

  @@index([clientId])
  @@map("device_tokens")
}

// ============================================================
// PROMEMORIA SULLA CLIENTE
// ============================================================
/// Cose da chiedere o da dire alla cliente QUANDO È QUI.
///
/// Non è una nota in scheda: quella si legge solo se qualcuno apre la scheda.
/// Questo salta fuori da solo al check-in, che è l'unico momento in cui la
/// persona è davanti a te e la domanda si può fare davvero.
model ClientReminder {
  id        String  @id @default(cuid())
  clientId  String
  testo     String
  /// Chi l'ha scritto, per sapere a chi chiedere spiegazioni.
  creatoDa  String?
  createdAt String
  /// Valorizzati quando qualcuno lo segna fatto: da lì non compare più.
  fattoIl   String?
  fattoDa   String?

  @@index([clientId])
  @@map("client_reminders")
}

// ============================================================
// NOTIFICHE PUSH INVIATE
// ============================================================
/// Registro di ogni push mandata alla cliente.
///
/// Serve a due cose: non mandare mai due volte lo stesso avviso
/// (il vincolo unico su clientId+tipo+refId è il lucchetto) e misurare
/// dal pannello cosa viene aperto e cosa disturba.
model AppNotification {
  id        String  @id @default(cuid())
  clientId  String
  /// 'promemoria-24h' | 'promemoria-2h' | 'waitlist' | 'drop' | ...
  tipo      String
  /// L'oggetto di cui si parla (id appuntamento, desiderio...): è la
  /// chiave dell'anti-doppione.
  refId     String
  titolo    String
  corpo     String
  dati      Json    @default("{}")
  inviataAt String
  apertaAt  String?
  /// 'ok' | 'no-token' | 'errore' — una riga c'è comunque, così il
  /// doppione non parte nemmeno quando il primo invio è fallito.
  esito     String

  @@unique([clientId, tipo, refId])
  @@index([clientId])
  @@map("app_notifications")
}

// ============================================================
// LISTA D'ATTESA INTELLIGENTE
// ============================================================
/// "Se si libera un posto così, avvisami."
///
/// Il desiderio muore da solo alla scadenza: una lista d'attesa che
/// avvisa per cose chieste due mesi fa insegna a ignorare gli avvisi.
model WaitlistWish {
  id            String  @id @default(cuid())
  clientId      String
  clientName    String
  treatmentId   String
  treatmentName String
  /// null = va bene qualsiasi operatrice
  operatorId    String?
  /// Giorni che vanno bene: 0=domenica ... 6=sabato. Vuoto = tutti.
  giorni        Int[]   @default([])
  dalleOre      String
  alleOre       String
  scadenza      String
  /// attiva | avvisata | annullata | scaduta
  stato         String  @default("attiva")
  createdAt     String

  @@index([clientId])
  @@index([stato])
  @@map("waitlist_wishes")
}

// ============================================================
// REVO SCORE
// ============================================================
/// Fotografia giornaliera del punteggio: il grafico dell'evoluzione
/// («+7 questo mese») si legge da qui, non si ricalcola sul passato.
model ScoreSnapshot {
  id         String @id @default(cuid())
  clientId   String
  /// YYYY-MM-DD (una per giorno per cliente)
  data       String
  totale     Int
  /// { costanza, percorso, cura, community } — i pezzi da 100
  componenti Json
  createdAt  String

  @@unique([clientId, data])
  @@index([clientId])
  @@map("score_snapshots")
}

// ============================================================
// REVO AI — CONVERSAZIONI
// ============================================================
/// La chat con l'assistente: una conversazione per cliente, i messaggi
/// in fila. Il costo si segna per vedere dal pannello quanto spende l'AI.
model AiMessage {
  id        String   @id @default(cuid())
  clientId  String
  /// 'cliente' | 'revo'
  ruolo     String
  testo     String
  /// Strumenti usati dall'AI in questa risposta (nomi), per capire cosa fa.
  strumenti String[] @default([])
  modello   String?
  costoUsd  Float?
  createdAt String

  @@index([clientId])
  @@map("ai_messages")
}

// ============================================================
// MISSIONI E BADGE
// ============================================================
/// Il riscatto di una missione. L'avanzamento NON sta qui: si calcola
/// dai dati veri quando serve (una missione «3 sedute senza saltare» si
/// legge dall'agenda, non da un contatore che può scordarsi di crescere).
model MissionClaim {
  id           String @id @default(cuid())
  clientId     String
  /// Codice della missione nel registro (lib/engines/missioni.ts)
  codice       String
  puntiDati    Int
  riscattataAt String

  @@unique([clientId, codice])
  @@index([clientId])
  @@map("mission_claims")
}

/// Badge conquistati: oggetti da bacheca nel Beauty Passport.
model ClientBadge {
  id          String @id @default(cuid())
  clientId    String
  codice      String
  nome        String
  assegnatoAt String

  @@unique([clientId, codice])
  @@index([clientId])
  @@map("client_badges")
}

// ============================================================
// BACHECA DELL'APP (promo del giorno e lavori del salone)
// ============================================================
/// Un post della bacheca: la promo di oggi o la foto di un lavoro.
///
/// La foto vive nel database come data-URI compressa dalla pagina del
/// gestionale (~100 KB): per il ritmo di un centro — un post al giorno —
/// regge per anni. Quando arriverà lo storage S3 della fase 3, migrare
/// sarà spostare una colonna, non ripensare la bacheca.
model AppPost {
  id          String  @id @default(cuid())
  /// 'promo' | 'lavoro'
  tipo        String
  titolo      String
  testo       String  @default("")
  /// data-URI jpeg compressa, o null per i post di solo testo
  foto        String?
  attivo      Boolean @default(true)
  /// Se alla pubblicazione è partita la notifica a tutte
  pushInviata Boolean @default(false)
  creatoDa    String?
  createdAt   String

  @@index([attivo, createdAt])
  @@map("app_posts")
}

// ============================================================
// RECLAMI ANONIMI DALL'APP
// ============================================================
/// Un reclamo anonimo: categoria e testo, NIENT'ALTRO.
///
/// L'anonimato non è una promessa, è un fatto del modello dati: qui non
/// c'è clientId, non c'è nome, non c'è telefono. L'endpoint verifica che
/// a scrivere sia una cliente vera (serve la sessione, contro lo spam)
/// ma butta via l'identità prima di salvare.
model Reclamo {
  id        String  @id @default(cuid())
  categoria String
  testo     String
  letto     Boolean @default(false)
  createdAt String

  @@index([letto, createdAt])
  @@map("reclami")
}

// ============================================================
// REGALI COI PUNTI (prodotti dello scaffale riscattabili dall'app)
// ============================================================
/// Un prodotto del magazzino messo "in regalo": quanti punti costa.
/// La scheda prodotto resta quella dell'inventario — qui c'è solo la
/// decisione del centro: questo sì, a tanti punti.
model PremioProdotto {
  id        String  @id @default(cuid())
  productId String  @unique
  punti     Int
  attivo    Boolean @default(true)
  createdAt String

  @@map("premi_prodotti")
}

/// Il riscatto: la cliente ha speso i punti, il prodotto la aspetta al banco.
/// Il codice si mostra in negozio; alla consegna lo stato cambia e lo stock
/// scala. I punti sono già stati tolti alla prenotazione del regalo.
model RiscattoPremio {
  id           String  @id @default(cuid())
  clientId     String
  clientName   String
  productId    String
  nomeProdotto String
  punti        Int
  /// da_ritirare | consegnato | annullato
  stato        String  @default("da_ritirare")
  /// Codice corto da mostrare al banco
  codice       String  @unique
  createdAt    String
  consegnatoAt String?

  @@index([clientId])
  @@index([stato])
  @@map("riscatti_premi")
}
